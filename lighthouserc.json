{
  "ci": {
    "collect": {
      "staticDistDir": "site",
      "url": ["http://localhost/acceptance.html"],
      "numberOfRuns": 3,
      "settings": {"chromeFlags": "--headless --no-sandbox"}
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", {"maxNumericValue": 2500, "aggregationMethod": "pessimistic"}],
        "categories:accessibility": ["error", {"minScore": 1}],
        "total-blocking-time": ["error", {"maxNumericValue": 200, "aggregationMethod": "pessimistic"}]
      }
    },
    "upload": {"target": "filesystem", "outputDir": ".verification/lighthouse"}
  }
}
