  "@type": "sc:Dataset",
  "name": "siftgrain-census-faults-v1",
  "description": "Controlled fault-seed splits on three shared archived Inspect sample IDs; synthetic second epoch. Record sets project flat answer-key fields; complete missing-pair keys remain in JSON.",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "url": "https://github.com/alawein/eval-audit",
  "license": "https://opensource.org/license/mit",
  "version": "1.0.0",
  "dateCreated": "2026-10-13",
  "creator": {
    "@type": "sc:Person",
    "name": "Meshal Alawein"
  },
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "dev-answers",
      "name": "dev-answers",
      "description": "Public dev fault-seed answer keys; original source IDs overlap both splits.",
      "contentUrl": "dataset-v1/dev-answers.json",
      "encodingFormat": "application/json",
      "sha256": "161473e632d313c886575707f73f6839a0b86fc510d919de8a2fbbdace0a3714"
    },
    {
      "@type": "cr:FileObject",
      "@id": "test-answers",
      "name": "test-answers",
      "description": "Public test fault-seed answer keys; original source IDs overlap both splits.",
      "contentUrl": "dataset-v1/test-answers.json",
      "encodingFormat": "application/json",
      "sha256": "eb268ea3136600f9d7d8c5dc5922d846d023e17fd2ecd85b5730fd5cca1c743c"
    },
    {
      "@type": "cr:FileObject",
      "@id": "archive",
      "name": "archive",
      "contentUrl": "dataset-v1.zip",
      "encodingFormat": "application/zip",
      "sha256": "df075472efd09bcf3355d3d2737ab2a961b8a8fbdcdc2f7f890f382584928895"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "dev",
      "name": "dev",
      "description": "Flat projection of the separate JSON answer-key array.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "dev/case",
          "name": "case",
          "description": "case",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "dev-answers"
            },
            "extract": {
              "jsonPath": "$[*].case"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "dev/fault",
          "name": "fault",
          "description": "fault",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "dev-answers"
            },
            "extract": {
              "jsonPath": "$[*].fault"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "dev/should_flag",
          "name": "should_flag",
          "description": "should flag",
          "dataType": "sc:Boolean",
          "source": {
            "fileObject": {
              "@id": "dev-answers"
            },
            "extract": {
              "jsonPath": "$[*].should_flag"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "dev/invalid",
          "name": "invalid",
          "description": "invalid",
          "dataType": "sc:Boolean",
          "source": {
            "fileObject": {
              "@id": "dev-answers"
            },
            "extract": {
              "jsonPath": "$[*].invalid"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "dev/expected_trials",
          "name": "expected_trials",
          "description": "expected trials",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "dev-answers"
            },
            "extract": {
              "jsonPath": "$[*].expected_trials"
            }
          }
        }
      ]
    },
    {
